[cells]
  root = .
  prelude = buck2/prelude
  toolchains = toolchains
  # haskell-buck2's own toolchains, a cell so that it isn't part of //...
  haskell-toolchains = buck2/toolchains
  third-party-haskell = third-party/haskell
  none = none
  # exclude this from buck2 build //...
  example = buck2/example

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  buck = none

[parser]
  target_platform_detector_spec = target:root//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default \
    target:third-party-haskell//...->prelude//platforms:default

[build]
  execution_platforms = root//buck2/platforms:exec

[cfg]
  # What configurations are named by (the names of these constraints'
  # values), as in cfg:opt-clang-stage1: see buck2/prelude/cfg/modifier/name.bzl.
  named_constraint_settings = root//buck2/constraints:build_mode, \
    root//buck2/constraints:linking, \
    prelude//cfg/exec_platform/marker:is_exec_platform, \
    root//buck2/constraints:profiling, \
    root//buck2/constraints:sanitizer, \
    root//buck2/constraints:compiler, \
    toolchains//:ghc_stage, \
    toolchains//:rts_variants, \
    toolchains//:rts_threaded, \
    toolchains//:rts_debug, \
    toolchains//:rts_dynamic
