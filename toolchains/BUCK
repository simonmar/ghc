load("@haskell-toolchains//:defaults.bzl", "CABAL_GHC", "CABAL_GHC_PKG", "default_haskell_toolchain", "default_toolchains")
load("@third-party-haskell//:tools.bzl", "GHC_DYNAMIC")
load("@root//cabal-buck2:packages.bzl", "PACKAGE_SETS", "PACKAGE_SET_LIBRARIES", "PACKAGE_TARGETS")
load(":libdir.bzl", "ghc_libdir", "ghc_toolchain")
load(":rts.bzl", "RTS_PACKAGE_WAYS", "rts_package", "rts_package_ways")
load(":rts_ways.bzl", "rts_way_settings", "rts_way_transitions")
load(":stages.bzl", "STAGES", "stage_alias", "stage_links_shared", "stage_tool", "stage_transition")

default_toolchains()

# The stage of a configuration. stage0 is represented by the absence of
# ghc_stage, so that a target built at stage0 is the same configured target
# whether it is reached by a transition or not, and so that the tools that
# a build runs (exec deps, which are configured for the execution platform)
# are built by the bootstrap GHC. A select() matches stage0 with DEFAULT.
constraint_setting(
    name = "ghc_stage",
    visibility = ["PUBLIC"],
)

[
    constraint_value(
        name = stage,
        constraint_setting = ":ghc_stage",
        visibility = ["PUBLIC"],
    )
    for stage in STAGES
]

# The transitions to each stage, which give it its build mode.
[
    stage_transition(
        name = "to-" + stage,
        stage = stage,
        visibility = ["PUBLIC"],
    )
    for stage in STAGES
]

# The libdir of the GHC of the next stage, built in this one's configuration
# (see stage_alias()): the stage2 GHC's, in stage1's, has the stage1
# libraries installed (as Hadrian's does), and the internal interpreter.
# The programs in it (and ghc-pkg) are for the execution platform.
_STAGE1_LIBRARIES = [
    PACKAGE_TARGETS.get(name, "root//" + PACKAGE_SETS["stage1"][name] + ":" + name)
    for name in PACKAGE_SET_LIBRARIES["stage1"]
]

export_file(name = "package_db.py")

ghc_libdir(
    name = "ghc-libdir",
    base = "root//libraries/base:base",
    ghc_library = "root//compiler:ghc",
    ghc_pkg = "root//utils/ghc-pkg:ghc-pkg",
    interpreter = select({":stage1": True, "DEFAULT": False}),
    packages = select({":stage1": _STAGE1_LIBRARIES, "DEFAULT": []}),
    # The ways of the installed RTS, or else every way that the RTS of what
    # the GHC builds may have.
    rts_ways = select({":stage1": rts_package_ways(), "DEFAULT": RTS_PACKAGE_WAYS}),
    target = "root//hadrian/cfg:default.target",
    unlit = "root//utils/unlit:unlit",
)

# The tools of stage N (N > 0), built at stage N-1: the compiler and ghc-pkg
# (which the toolchain runs, for the execution platform), and their libdir
# (for what they build, so the stage2 GHC's has the same stage1 libraries as
# what is built at stage1 has).
_STAGE_TOOLS = {
    "ghc": "root//ghc:ghc",
    "ghc-pkg": "root//utils/ghc-pkg:ghc-pkg",
    "libdir": ":ghc-libdir",
}

[
    stage_alias(
        name = stage + "-" + tool,
        actual = actual,
        stage = STAGES[i],
        visibility = ["PUBLIC"],
    )
    for i, stage in enumerate(STAGES[1:])
    for tool, actual in _STAGE_TOOLS.items()
]

# The Haskell toolchain: the stage's GHC, with its libdir.
ghc_toolchain(
    name = "haskell",
    libdir = stage_tool("libdir", None),
    toolchain = ":haskell-without-libdir",
    visibility = ["PUBLIC"],
)

default_haskell_toolchain(
    name = "haskell-without-libdir",
    compiler = stage_tool("ghc", CABAL_GHC),
    packager = stage_tool("ghc-pkg", CABAL_GHC_PKG),
    # A GHC that the build makes is linked as the build mode of the stage
    # before says.
    dynamic_ghc = select(dict(
        {"toolchains//:" + stage: stage_links_shared(STAGES[n]) for n, stage in enumerate(STAGES[1:])},
        DEFAULT = GHC_DYNAMIC,
    )),
)

# The units of the RTS's ways (see rts_ways.bzl), besides profiling, which is
# root//buck2/constraints:prof.
constraint_setting(
    name = "rts_threaded",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "threaded",
    constraint_setting = ":rts_threaded",
    visibility = ["PUBLIC"],
)

constraint_setting(
    name = "rts_debug",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "debug",
    constraint_setting = ":rts_debug",
    visibility = ["PUBLIC"],
)

constraint_setting(
    name = "rts_dynamic",
    visibility = ["PUBLIC"],
)

constraint_value(
    name = "dynamic",
    constraint_setting = ":rts_dynamic",
    visibility = ["PUBLIC"],
)

rts_way_settings()
rts_way_transitions()

rts_package(
    name = "rts",
    ghc_pkg = "root//utils/ghc-pkg:ghc-pkg",
    library = "root//rts:rts",
)
