load("@haskell-toolchains//:defaults.bzl", "default_haskell_toolchain", "default_toolchains")
load("@third-party-haskell//:tools.bzl", "GHC", "GHC_DYNAMIC", "GHC_PKG", "HADDOCK", "HSC2HS")
load("@root//buck2/platforms:defs.bzl", "execution_platform_with_constraints", "execution_platforms")
load("@root//cabal-buck2:packages.bzl", "PACKAGE_SETS", "PACKAGE_SET_LIBRARIES", "PACKAGE_TARGETS")
load(":freeze.bzl", "FROZEN_TOOLS", "freeze_stage1", "stage_tool_alias")
load(":hsc2hs.bzl", "hsc2hs")
load(":libdir.bzl", "ghc_libdir", "ghc_toolchain")
load(":per_module_tools.bzl", "per_module_tools")
load(":rts.bzl", "PROFILED_LIBRARIES", "RTS_PACKAGE_WAYS", "rts_package", "rts_package_ways")
load(":rts_ways.bzl", "rts_way_settings", "rts_way_transitions")
load(":stages.bzl", "STAGES", "stage_alias", "stage_links_shared", "stage_modes", "stage_tool", "stage_transition")
load(":unit_ids.bzl", "BASE_UNIT_ID", "GHC_UNIT_ID")

default_toolchains()

# The stage of a configuration. stage0 is represented by the absence of
# ghc_stage, so that a target built at stage0 is the same configured target
# whether it is reached by a transition or not, and so that the tools that
# a build runs (exec deps, which are configured for the execution platform)
# are built by the bootstrap GHC. A select() matches stage0 with DEFAULT.
constraint_setting(
    name = "ghc_stage",
    visibility = ["PUBLIC"],
)

[
    constraint_value(
        name = stage,
        constraint_setting = ":ghc_stage",
        visibility = ["PUBLIC"],
    )
    for stage in STAGES
]

# The transitions to each stage, which give it its build mode.
[
    stage_transition(
        name = "to-" + stage,
        stage = stage,
        visibility = ["PUBLIC"],
    )
    for stage in STAGES
]

# The execution platform, which `[build] execution_platforms` in .buckconfig
# names. The tools that the build runs, such as alex or genprimopcode, are
# exec deps, and an exec dep is configured with the execution platform's
# constraints. These tools are built by the bootstrap GHC, so they should be
# built in the build mode of stage0. Otherwise they would have the default
# execution platform's mode (dev), and the libraries that they share with
# the stage1 GHC, such as Cabal, would be compiled a second time in that
# mode.
execution_platform_with_constraints(
    name = "exec-stage0",
    base = "root//buck2/platforms:exec-default",
    constraint_values = stage_modes("stage0"),
)

execution_platforms(
    name = "exec",
    platforms = [
        ":exec-stage0",
        "root//buck2/platforms:exec-opt",
    ],
    visibility = ["PUBLIC"],
)

# The libdir of the GHC of the next stage, built in this one's configuration
# (see stage_alias()): the stage2 GHC's, in stage1's, has the stage1
# libraries installed (as Hadrian's does), and the internal interpreter.
# The programs in it (and ghc-pkg) are for the execution platform.
_STAGE1_LIBRARIES = [
    PACKAGE_TARGETS.get(name, "root//" + PACKAGE_SETS["stage1"][name] + ":" + name)
    for name in PACKAGE_SET_LIBRARIES["stage1"]
]

export_file(name = "package_db.py")

# Two libdirs, which differ only in whether they install profiled libraries.
# Both have them when the GHC is itself profiled, because its internal
# interpreter loads profiled code. Otherwise, the libdir of the GHC that the
# build uses has none, and that of an installation of the GHC has them if
# `[ghc] profiled_libraries` says so. Profiling isn't part of the
# configuration, so both libdirs have the same stage1 libraries, and the
# profiled ones are only built for the libdir that installs them.
[
    ghc_libdir(
        name = name,
        base_unit_id = BASE_UNIT_ID,
        extra_packages = ["root//mk:system-cxx-std-lib-1.0.conf"],
        files = {f: "root//:" + f for f in ["ghc-usage.txt", "ghci-usage.txt", "llvm-passes", "llvm-targets"]},
        ghc_pkg = "root//utils/ghc-pkg:ghc-pkg",
        ghc_unit_id = GHC_UNIT_ID,
        haddock_data = "root//utils/haddock/haddock-api:haddock-api-data",
        hsc2hs_data = select({":stage1": "root//utils/hsc2hs:hsc2hs-data", "DEFAULT": None}),
        interpreter = select({":stage1": True, "DEFAULT": False}),
        packages = select({":stage1": _STAGE1_LIBRARIES, "DEFAULT": []}),
        profiled = select({"root//buck2/constraints:prof": True, "DEFAULT": profiled}),
        # The ways of the installed RTS, or else every way that the RTS of what
        # the GHC builds may have.
        rts_ways = select({
            ":stage1": select({
                "root//buck2/constraints:prof": rts_package_ways(profiled = True),
                "DEFAULT": rts_package_ways(profiled = profiled),
            }),
            "DEFAULT": RTS_PACKAGE_WAYS,
        }),
        target = "root//hadrian/cfg:default.target",
        unlit = "root//utils/unlit:unlit",
    )
    for name, profiled in [
        ("ghc-libdir", False),
        ("ghc-install-libdir", PROFILED_LIBRARIES),
    ]
]

# The tools of stage N (N > 0), built at stage N-1: the compiler, ghc-pkg,
# haddock, and the tools and worker of the per-module compiles (which the
# toolchain runs, for the execution platform), and their libdir (for what
# they build, so the stage2 GHC's has the same stage1 libraries as what is
# built at stage1 has).
_STAGE_TOOLS = {
    "ghc": "root//ghc:ghc",
    "ghc-pkg": "root//utils/ghc-pkg:ghc-pkg",
    "haddock": "root//utils/haddock:haddock",
    "libdir": ":ghc-libdir",
    "per-module-compile": ":per_module_compile",
    "per-module-deps": ":per_module_deps",
    "per-module-worker": ":per_module_worker",
}

per_module_tools()

[
    stage_tool_alias(
        name = stage + "-" + tool,
        stage = stage,
        tool = tool,
        actual = actual,
        build_stage = STAGES[i],
        visibility = ["PUBLIC"],
    )
    for i, stage in enumerate(STAGES[1:])
    for tool, actual in _STAGE_TOOLS.items()
]

# The libdir of an installation of the stage2 GHC, which can have profiled
# libraries (see ghc-install-libdir above).
stage_alias(
    name = "stage2-install-libdir",
    actual = ":ghc-install-libdir",
    stage = "stage1",
    visibility = ["PUBLIC"],
)

# Snapshot the stage1 programs into `toolchains/_frozen/stage1`
# for `[ghc] freeze1` (see freeze.bzl):
#
#   buck2 run toolchains//:freeze-stage1
freeze_stage1(
    name = "freeze-stage1",
    script = "freeze_stage1.sh",
    tools = {tool: ":stage1-{}-built".format(tool) for tool in FROZEN_TOOLS},
)

# The hsc2hs of the later stages, built at stage0 (as Hadrian builds it).
hsc2hs(
    name = "hsc2hs",
    data = "root//utils/hsc2hs:hsc2hs-data",
    hsc2hs = "root//utils/hsc2hs:hsc2hs-stage0",
)

# The Haskell toolchain: the stage's GHC, with its libdir.
ghc_toolchain(
    name = "haskell",
    libdir = stage_tool("libdir", None),
    toolchain = ":haskell-without-libdir",
    visibility = ["PUBLIC"],
)

# Profiling detail level for all Haskell compilations, using the same naming
# scheme as Cabal's --profiling-detail=<level> option.
#
# The testsuite's profiling tests expect late-toplevel, so that's the default.
_PROFILING_DETAIL = {
    "all-functions": ["-fprof-auto"],
    "exported-functions": ["-fprof-auto-exported"],
    "late-toplevel": ["-fprof-late"],
    "none": [],
    "toplevel-functions": ["-fprof-auto-top"],
}

_profiling_detail = read_root_config("ghc", "profiling_detail", "late-toplevel")

_profiling_detail in _PROFILING_DETAIL or fail("[ghc] profiling_detail: unknown level {}, expected one of {}".format(
    repr(_profiling_detail),
    ", ".join(_PROFILING_DETAIL),
))

default_haskell_toolchain(
    name = "haskell-without-libdir",
    compiler = stage_tool("ghc", GHC),
    compiler_flags = select(dict(
        {"toolchains//:" + stage: _PROFILING_DETAIL[_profiling_detail] for stage in STAGES[1:]},
        DEFAULT = [],
    )),
    packager = stage_tool("ghc-pkg", GHC_PKG),
    haddock = stage_tool("haddock", HADDOCK),
    # At stage0, the prelude's tools and worker, which the bootstrap GHC
    # builds.
    per_module_compile = stage_tool("per-module-compile", None),
    per_module_deps = stage_tool("per-module-deps", None),
    per_module_worker_program = stage_tool("per-module-worker", None),
    hsc2hs = select(dict(
        {"toolchains//:" + stage: ":hsc2hs" for stage in STAGES[1:]},
        DEFAULT = HSC2HS,
    )),
    # A GHC that the build makes is linked as the build mode of the stage
    # before says.
    dynamic_ghc = select(dict(
        {"toolchains//:" + stage: stage_links_shared(STAGES[n]) for n, stage in enumerate(STAGES[1:])},
        DEFAULT = GHC_DYNAMIC,
    )),
)

# The units of the RTS's ways (see rts_ways.bzl), besides profiling, which is
