-- The packages of stage1: built by the stage1 compiler (see `cabal buck2
-- --later-stage`). Only the packages and their flags are taken from here:
-- nothing is solved.
--
-- TODO: the flags are what Hadrian gives these packages on x86_64 Linux;
-- configure should work them out.
packages: rts
          libraries/ghc-internal
          libraries/ghc-prim
          libraries/libffi-clib
          libraries/base
          libraries/array
          libraries/binary
          libraries/bytestring
          libraries/containers/containers
          libraries/deepseq
          libraries/exceptions
          libraries/ghc-bignum
          libraries/ghc-boot-th
          libraries/ghc-compact
          libraries/ghc-experimental
          libraries/ghc-heap
          libraries/mtl
          libraries/parsec
          libraries/pretty
          libraries/stm
          libraries/template-haskell
          libraries/text
          libraries/transformers
          -- Also built by the bootstrap compiler (cabal.project)
          libraries/Cabal/Cabal-syntax
          libraries/Cabal/Cabal
          libraries/directory
          libraries/file-io
          libraries/filepath
          libraries/ghc-boot
          libraries/ghc-platform
          libraries/ghci
          libraries/haskeline
          libraries/hpc
          libraries/os-string
          libraries/process
          libraries/semaphore-compat
          libraries/template-haskell-lift
          libraries/template-haskell-quasiquoter
          libraries/terminfo
          libraries/time
          libraries/unix
          libraries/xhtml
          utils/haddock/haddock-library
          utils/ghc-toolchain
          -- The stage2 compiler, and the other programs of stage1
          compiler
          ghc
          utils/ghc-pkg
          utils/ghc-toolchain/exe
          utils/hp2ps
          utils/hpc
          utils/hsc2hs
          utils/runghc
          utils/unlit

package rts
  flags: +librt -use-system-libffi -libffi-adjustors -libbfd -need-atomic -libdw -libnuma -libzstd -static-libzstd -leading-underscore -unregisterised +tables-next-to-code

package ghc-internal
  flags: +bignum-native -bignum-gmp

package text
  flags: -simdutf

-- As Hadrian builds them at stage1 (not cross-compiling).
package ghc
  flags: +internal-interpreter

package ghc-bin
  flags: +interpreter +internal-interpreter +threaded

package ghci
  flags: +internal-interpreter
