-- The project that `cabal buck2` generates the buck2 build from.
packages: compiler
          ghc
          utils/unlit
          utils/genprimopcode
          utils/deriveConstants
          utils/genapply
          utils/hp2ps
          -- Libraries built by the bootstrap compiler (stage0)
          libraries/Cabal/Cabal-syntax
          libraries/Cabal/Cabal
          libraries/directory
          libraries/file-io
          libraries/filepath
          libraries/ghc-boot
          libraries/ghc-boot-th-next
          libraries/ghc-platform
          libraries/ghci
          libraries/haskeline
          libraries/hpc
          libraries/os-string
          libraries/process
          libraries/semaphore-compat
          libraries/template-haskell-lift
          libraries/template-haskell-quasiquoter
          libraries/terminfo
          libraries/time
          libraries/unix
          libraries/xhtml
          utils/haddock/haddock-library
          utils/ghc-toolchain
          utils/ghc-toolchain/exe
          utils/ghc-pkg
          utils/hpc
          utils/hsc2hs
          utils/runghc
          -- The testsuite driver's programs, which run where the build does
          testsuite/ghc-config

-- The boot libraries' own test-suites and benchmarks aren't part of the GHC
-- build, and some of them would make cyclic dependencies (file-io's test-suite
-- needs temporary, which needs directory, which needs file-io).
tests: False
benchmarks: False

-- ghc-boot-th-next vendors the in-tree TH AST definitions for the stage1
-- compiler: see Note [Bootstrapping Template Haskell].
package ghc-boot-th-next
  flags: +bootstrap

-- As Hadrian builds them at stage0.
package ghc-boot
  flags: +bootstrap

package ghci
  flags: +bootstrap

-- The stage1 compiler, built by the bootstrap compiler, with the flags Hadrian
-- gives it. Cabal won't otherwise build the ghc library: it is one of the
-- packages that come with the bootstrap compiler, which Cabal doesn't
-- reinstall by default.
allow-boot-library-installs: True

-- Not +internal-interpreter: like stage0's ghci (see Settings/Packages.hs in
-- Hadrian), and the stage1 compiler, which runs on the bootstrap compiler's
-- RTS, can't load the code it compiles into itself anyway.
package ghc
  flags: +bootstrap

package ghc-bin
  flags: +interpreter +threaded
